(version 1)
(rule "via_count_W020_C015_NOVIA"
  (condition "A.NetName == 'OSC_IN' || A.NetName == 'OSC_OUT'")
  (constraint via_count (max 0)))
(rule "nc_W020_C020_clearance"
  (condition "A.NetName == 'S1_OUT' || A.NetName == 'S2_OUT' || A.NetName == 'S3_OUT' || A.NetName == 'S4_OUT' || A.NetName == 'S5_OUT' || A.NetName == 'S6_OUT'")
  (constraint clearance (min 0.200mm)))
(rule "nc_W040_C020_OUT_clearance"
  (condition "A.NetName == 'VIN'")
  (constraint clearance (min 0.200mm)))
